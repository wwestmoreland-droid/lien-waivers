# Copy to .env and fill in. Never commit .env.

# Database. Leave unset locally to use SQLite in ./data; Railway sets DATABASE_URL for its Postgres.
# DATABASE_URL=postgresql://user:pass@host:5432/lienwaiver
DATA_DIR=./data

APP_BASE_URL=http://localhost:8000
# Long random string: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Smartsheet API token (read-only use). Smartsheet > Account > Apps & Integrations > API Access.
SMARTSHEET_TOKEN=

# Google OAuth client (Internal) for sign-in, and later for connecting mailboxes.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_DOMAIN=buildoutpros.com

# Local development only, when GOOGLE_CLIENT_ID is empty: act as this user without signing in.
DEV_AUTH_EMAIL=wwestmoreland@buildoutpros.com

ADMIN_EMAILS=wwestmoreland@buildoutpros.com
DEFAULT_REVIEWER_EMAIL=wwestmoreland@buildoutpros.com
TIMEZONE=America/Chicago
SYNC_INTERVAL_MINUTES=15
RUN_SCHEDULER=true

# Email. MAIL_PROVIDER=fake runs without Gmail (local development).
MAIL_PROVIDER=gmail
# Claude reads returned waivers (advisory). Leave empty to check them by eye.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# Optional key for encrypting mailbox tokens; derived from SECRET_KEY when empty.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
